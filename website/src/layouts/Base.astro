---
import '../styles/global.css';
import { profile } from '../content/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.shortName} — Machine Learning & Computer Vision`,
  description = profile.tagline,
} = Astro.props;

const nav = [
  { href: '/#experience', label: 'experience' },
  { href: '/#projects', label: 'projects' },
  { href: '/#research', label: 'research' },
  { href: '/cv.pdf', label: 'cv' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content="jossuema.me" />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0e14" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;650;750&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand mono" aria-label="Home">
          <span class="brand-bracket">[</span>jossuema<span class="brand-bracket">]</span>
        </a>
        <nav aria-label="Main">
          <ul class="nav-list">
            {
              nav.map((item, i) => (
                <li>
                  <a href={item.href} class="nav-link mono">
                    <span class="nav-num">0{i + 1}.</span>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="mono footer-line">
          <span class="prompt">$</span> echo "thanks for scrolling"
        </p>
        <p class="footer-meta">
          © {new Date().getFullYear()} {profile.name} · Machala, Ecuador ·
          <a href={profile.github}>GitHub</a> ·
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>
        <p class="footer-meta faint">
          Built with Astro · Content versioned at
          <a href={profile.github + '/' + profile.handle}>{profile.handle}/{profile.handle}</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: rgba(10, 14, 20, 0.82);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .brand {
    color: var(--text-strong);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .brand-bracket {
    color: var(--accent);
  }

  .nav-list {
    display: flex;
    gap: 1.6rem;
    list-style: none;
  }

  .nav-link {
    font-size: 0.8rem;
    color: var(--muted);
    transition: color 140ms ease;
  }

  .nav-link:hover {
    color: var(--accent-strong);
  }

  .nav-num {
    color: var(--accent);
    margin-right: 0.15rem;
  }

  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--border);
    padding: 2.5rem 0 3rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-line {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .prompt {
    color: var(--accent);
  }

  .footer-meta {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .footer-meta.faint {
    color: var(--faint);
  }

  @media (max-width: 640px) {
    .header-inner {
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }

    .nav-list {
      gap: 1rem;
      flex-wrap: wrap;
    }
  }
</style>
