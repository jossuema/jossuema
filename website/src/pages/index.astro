---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  profile,
  experience,
  research,
  education,
  awards,
  skills,
  community,
  languages,
} from '../content/profile';
import { loadProjects } from '../lib/projects';

const projects = loadProjects();
const featured = projects.filter((p) => p.featured);
---

<Base>
  <!-- ============ Hero ============ -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="mono hero-prompt">
          <span class="prompt">~ $</span> whoami<span class="cursor" aria-hidden="true"></span>
        </p>
        <h1 class="hero-name">{profile.name}</h1>
        <p class="mono hero-role">
          {profile.role} <span class="sep">·</span> {profile.location}
        </p>
        <p class="hero-tagline">{profile.tagline}</p>
        <div class="hero-highlights">
          {profile.highlights.map((h) => <span class="chip accent">{h.label}</span>)}
        </div>
        <div class="hero-actions">
          <a class="btn primary" href="/cv.pdf">download cv</a>
          <a class="btn" href={profile.github} rel="noopener">github ↗</a>
          <a class="btn" href={`mailto:${profile.email}`}>email</a>
        </div>
      </div>

      <aside class="terminal" aria-label="Profile summary, styled as a terminal window">
        <div class="terminal-bar">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="mono terminal-title">profile.yaml</span>
        </div>
        <pre class="mono terminal-body"><code><span class="c"># who</span>
<span class="k">name</span>: josue_malla
<span class="k">role</span>: ml_engineer <span class="c"># @larvia</span>
<span class="k">focus</span>:
  - computer_vision
  - edge_ai
  - remote_sensing
<span class="k">research</span>:
  - lidar_tree_detection
  - electrochemical_sensors
<span class="k">base</span>: machala_ec <span class="c"># -3.26, -79.96</span>
<span class="k">langs</span>: [es, en, pt]
<span class="k">status</span>: <span class="v">open_to_collaborate</span></code></pre>
      </aside>
    </div>
  </section>

  <!-- ============ About ============ -->
  <section class="section" id="about">
    <div class="container">
      <SectionHead num="00" title="About" />
      <div class="about-cols">
        {profile.about.map((p) => <p class="about-p">{p}</p>)}
      </div>
    </div>
  </section>

  <!-- ============ Experience ============ -->
  <section class="section" id="experience">
    <div class="container">
      <SectionHead num="01" title="Experience" />
      <ol class="timeline">
        {
          experience.map((job) => (
            <li class="timeline-item">
              <div class="timeline-meta mono">
                <span class="when">{job.when}</span>
                <span class="kind">{job.kind}</span>
              </div>
              <div class="timeline-body">
                <h3>
                  {job.role} <span class="org">· {job.org}</span>
                </h3>
                <p class="mono where">{job.where}</p>
                <ul>
                  {job.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ Projects ============ -->
  <section class="section" id="projects">
    <div class="container">
      <SectionHead num="02" title="Featured projects" />
      <div class="projects-grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
      <p class="all-link mono">
        <a href="/projects">view all {projects.length} projects →</a>
      </p>
    </div>
  </section>

  <!-- ============ Research ============ -->
  <section class="section" id="research">
    <div class="container">
      <SectionHead num="03" title="Research" />
      <div class="research-list">
        {
          research.map((item) => (
            <article class="card research-item">
              <p class="mono venue">{item.venue}</p>
              <h3>{item.title}</h3>
              <p class="research-desc">{item.description}</p>
              {item.link && (
                <p class="mono research-link">
                  <a href={item.link} rel="noopener">
                    {item.linkLabel} ↗
                  </a>
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ Education & Honors ============ -->
  <section class="section" id="education">
    <div class="container">
      <SectionHead num="04" title="Education & honors" />
      <div class="edu-grid">
        <div>
          <h3 class="subhead mono">// education</h3>
          <ul class="edu-list">
            {
              education.map((e) => (
                <li>
                  <span class="mono when">{e.when}</span>
                  <div>
                    <strong>{e.degree}</strong>
                    <p class="edu-org">
                      {e.org} · {e.where}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="subhead mono">// honors</h3>
          <ul class="awards-list">
            {
              awards.map((a) => (
                <li>
                  <span class="mono when">{a.year}</span>
                  <span>{a.what}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Skills ============ -->
  <section class="section" id="skills">
    <div class="container">
      <SectionHead num="05" title="Skills" />
      <div class="skills-grid">
        {
          skills.map((group) => (
            <div class="skill-group">
              <h3 class="subhead mono">// {group.group.toLowerCase()}</h3>
              <div class="skill-chips">
                {group.items.map((item) => (
                  <span class="chip">{item}</span>
                ))}
              </div>
            </div>
          ))
        }
        <div class="skill-group">
          <h3 class="subhead mono">// human languages</h3>
          <div class="skill-chips">
            {
              languages.map((l) => (
                <span class="chip">
                  {l.name} · {l.level}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Community ============ -->
  <section class="section" id="community">
    <div class="container">
      <SectionHead num="06" title="Community" />
      <ul class="community-list">
        {
          community.map((c) => (
            <li>
              <span class="mono when">{c.when}</span>
              <span>{c.what}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ Contact ============ -->
  <section class="section" id="contact">
    <div class="container">
      <div class="contact card">
        <p class="mono contact-kicker"><span class="prompt">$</span> ./get_in_touch.sh</p>
        <h2>Let's build something.</h2>
        <p class="contact-p">
          Open to research collaborations, ML engineering work, and speaking
          at community events — especially anything involving computer
          vision in the real world.
        </p>
        <div class="hero-actions">
          <a class="btn primary" href={`mailto:${profile.email}`}>{profile.email}</a>
          <a class="btn" href={profile.github} rel="noopener">github/{profile.handle} ↗</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding: 5.5rem 0 2rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-prompt {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .prompt {
    color: var(--accent);
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.35em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .hero-name {
    font-size: clamp(2rem, 5vw, 3.1rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.7rem;
  }

  .hero-role {
    color: var(--accent);
    font-size: 0.95rem;
    margin-bottom: 1.2rem;
  }

  .hero-role .sep {
    color: var(--faint);
  }

  .hero-tagline {
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 34rem;
    margin-bottom: 1.4rem;
  }

  .hero-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.8rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  /* ---------- Terminal card ---------- */
  .terminal {
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 0.9rem;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .dot.red { background: #f7768e; }
  .dot.yellow { background: #e0af68; }
  .dot.green { background: #9ece6a; }

  .terminal-title {
    margin-left: auto;
    font-size: 0.72rem;
    color: var(--faint);
  }

  .terminal-body {
    padding: 1.1rem 1.2rem 1.3rem;
    font-size: 0.8rem;
    line-height: 1.75;
    overflow-x: auto;
    color: var(--text);
  }

  .terminal-body .k { color: var(--accent); }
  .terminal-body .c { color: var(--faint); }
  .terminal-body .v { color: #e0af68; }

  /* ---------- About ---------- */
  .about-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    max-width: 60rem;
  }

  .about-p {
    color: var(--text);
    font-size: 0.98rem;
  }

  /* ---------- Timeline ---------- */
  .timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.6rem;
    position: relative;
  }

  .timeline-meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.78rem;
  }

  .timeline-meta .when {
    color: var(--accent);
  }

  .timeline-meta .kind {
    color: var(--faint);
  }

  .timeline-body {
    border-left: 1px solid var(--border-strong);
    padding-left: 1.6rem;
    position: relative;
  }

  .timeline-body::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.5em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .timeline-body h3 {
    font-size: 1.05rem;
  }

  .timeline-body .org {
    color: var(--muted);
    font-weight: 500;
  }

  .timeline-body .where {
    color: var(--faint);
    font-size: 0.75rem;
    margin: 0.25rem 0 0.5rem;
  }

  .timeline-body ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .timeline-body ul li {
    font-size: 0.92rem;
    color: var(--text);
    padding-left: 1.1rem;
    position: relative;
  }

  .timeline-body ul li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 0.8rem;
  }

  /* ---------- Projects ---------- */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }

  .all-link {
    margin-top: 1.4rem;
    font-size: 0.85rem;
  }

  /* ---------- Research ---------- */
  .research-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .research-item .venue {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .research-item h3 {
    font-size: 1.08rem;
    margin-bottom: 0.4rem;
  }

  .research-desc {
    font-size: 0.93rem;
    color: var(--text);
    max-width: 52rem;
  }

  .research-link {
    margin-top: 0.5rem;
    font-size: 0.8rem;
  }

  /* ---------- Education & honors ---------- */
  .edu-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
  }

  .subhead {
    color: var(--faint);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }

  .edu-list,
  .awards-list,
  .community-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .edu-list li,
  .awards-list li,
  .community-list li {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 1rem;
    font-size: 0.92rem;
  }

  .edu-list .when,
  .awards-list .when,
  .community-list .when {
    color: var(--accent);
    font-size: 0.78rem;
    padding-top: 0.15em;
  }

  .edu-org {
    color: var(--muted);
    font-size: 0.85rem;
  }

  /* ---------- Skills ---------- */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.8rem 2.5rem;
  }

  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  /* ---------- Contact ---------- */
  .contact {
    margin-top: 2rem;
    text-align: left;
    padding: 2.4rem 2.2rem;
    background:
      radial-gradient(ellipse 60% 120% at 85% 0%, rgba(79, 214, 190, 0.07), transparent),
      var(--surface);
  }

  .contact-kicker {
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 0.8rem;
  }

  .contact h2 {
    font-size: 1.7rem;
    margin-bottom: 0.7rem;
  }

  .contact-p {
    color: var(--muted);
    max-width: 38rem;
    margin-bottom: 1.5rem;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }

    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 720px) {
    .hero {
      padding-top: 3.5rem;
    }

    .about-cols,
    .projects-grid,
    .edu-grid {
      grid-template-columns: 1fr;
    }

    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .timeline-meta {
      flex-direction: row;
      gap: 0.9rem;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
